# HyperFrames render outputs and caches: rebuilt locally, not kept in Git.
renders/
snapshots/
.thumbnails/
.hyperframes/
.waveform-cache/
check.log
# Analysis images from the score scripts
**/audio-src/*.png
# Full system-font copy used only to re-subset (see promo/scripts/subset-font.py)
promo/scripts/font-src/
promo/scripts/.chars.txt
# Trailer gameplay captures (large; re-record with trailer/scripts/capture.mjs) and font glyph list
trailer/assets/video/*.mp4
trailer/scripts/.chars.txt
# Surge: the licensed song and every mix that contains it stay out of Git; large captures too
surge/assets/audio/raya.*
surge/assets/audio/soundtrack.wav
surge/assets/video/*.mp4
surge/scripts/.chars.txt
surge-916/assets/audio/raya.*
surge-916/assets/audio/soundtrack.wav
surge-916/assets/video/*.mp4
surge-916/scripts/.chars.txt
# Highlights: the song and every mix that contains it stay out of Git
highlights/assets/audio/song.*
highlights/assets/audio/soundtrack.wav
highlights/scripts/.chars.txt
# Highlights (live footage): the song, its mixes, and the recordings stay out of Git
highlights-live/assets/audio/song.*
highlights-live/assets/audio/soundtrack.wav
highlights-live/assets/video/*.mp4
highlights-live/assets/video/*.log
highlights-live/assets/video/probe-*
highlights-live/scripts/.chars.txt
# Highlights (Raya): the licensed song, its mixes, and the recordings stay out of Git
highlights-raya/assets/audio/song.*
highlights-raya/assets/audio/soundtrack.wav
highlights-raya/assets/video/*.mp4
highlights-raya/scripts/.chars.txt
