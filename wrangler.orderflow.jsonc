// Order-flow data Worker: the Bybit collector Durable Object and its read API.
// Separate from the CRM backend (wrangler.jsonc); see src/orderflow/index.ts and
// docs/ORDERFLOW-PLATFORM.md. Deploy with `npm run orderflow:deploy` (a release step).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metabear-orderflow",
  "main": "src/orderflow/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [{ "pattern": "metabear.io/api/orderflow/*", "zone_name": "metabear.io" }],
  "durable_objects": {
    "bindings": [{ "name": "COLLECTOR", "class_name": "Collector" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Collector"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  // Alerts reach the admin's LINE through the CRM backend (src/orderflow-alert.ts), which holds
  // the LINE token. Both Workers need the ORDERFLOW_ALERT_TOKEN secret.
  "services": [{ "binding": "BACKEND", "service": "metabear-backend" }],
  "vars": { "ORDERFLOW_ALERTS": "live" },
  "observability": { "enabled": true },
}
