# MetaBear LINE Bot 環境設定範本（Cloudflare Workers 版本）
# 將以下內容複製為 .env 使用於本機舊版程序參考；正式環境建議透過 Cloudflare Secrets / wrangler vars 管理。

# ===== 管理後台 =====
# 開發環境 local 預覽用，請設定至少 32 位元以上隨機字串
ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters

# ===== LINE 設定 =====
# 至 LINE Developers > Messaging API 取得
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN

# ===== LLM（OpenAI / Responses API）=====
# 這是目前 Worker 會使用的模型名稱（預設值於 wrangler.jsonc 提供）
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna

# ===== BingX API（自動化核驗）=====
BINGX_API_KEY=YOUR_BINGX_API_KEY
BINGX_SECRET_KEY=YOUR_BINGX_SECRET_KEY
