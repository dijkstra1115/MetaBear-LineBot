{
  "name": "metabear-line-crm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply metabear-crm --local",
    "types": "wrangler types --strict-vars false",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run",
    "build:staging": "wrangler deploy --env staging --dry-run",
    "db:migrate:staging": "wrangler d1 migrations apply metabear-crm-staging --env staging --remote",
    "deploy": "wrangler deploy --env staging",
    "build:site": "node scripts/build-site.mjs",
    "predev": "npm run build:site",
    "prebuild": "npm run build:site",
    "prebuild:staging": "npm run build:site",
    "predeploy": "npm run build:site"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260911.0-alpha",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "jose": "^6.2.12"
  }
}
